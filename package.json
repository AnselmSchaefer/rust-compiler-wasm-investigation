{
  "name": "browser-rust-ide",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "doctor": "bash scripts/doctor.sh",
    "test:e2e": "playwright test",
    "bench": "node bench/run.ts",
    "build:app": "bash scripts/build-vfs.sh && node scripts/build-app.mjs",
    "demo": "pnpm build:app && node scripts/serve.mjs build/www/app /release=build/release",
    "ide": "pnpm build:app && python3 tools/relay/relay.py --no-mcp --browser headed"
  },
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@oligami/browser_wasi_shim-threads": "0.5.0",
    "@playwright/test": "latest",
    "esbuild": "0.28.2",
    "typescript": "latest"
  },
  "dependencies": {
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2"
  }
}
